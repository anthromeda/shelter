{
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "chalk": "^5.6.2",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^25.2.0",
    "@vitest/ui": "^4.0.18",
    "commander": "^14.0.3",
    "vitest": "^4.0.18"
  },
  "name": "shelter",
  "module": "src/index.ts",
  "type": "module",
  "peerDependencies": {
    "typescript": "^5"
  },

  "scripts": {
    "start": "bun run ./src/index.ts",
    "build:js": "bun build --target bun --minify ./src/index.ts --outfile ./dist/bundle.js",
    "build:daemon": "bun build --compile --outfile=./dist/shelter-daemon ./apps/daemon.ts",
    "build:daemon:windows": "bun build --compile --platform=windows --outfile=./dist/shelter-daemon.exe ./apps/daemon.ts",
    "build:cli": "bun build --compile --outfile=./dist/shelter-cli ./apps/cli.ts",
    "build:cli:windows": "bun build --compile --platform=windows --outfile=./dist/shelter-cli.exe ./apps/cli.ts",
    "test": "bun run vitest"
  }
}
